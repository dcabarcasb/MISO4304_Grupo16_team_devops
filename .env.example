# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# PostgreSQL connection (local or AWS RDS)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blacklist

# Secret used to sign/verify JWTs
JWT_SECRET_KEY=change-me-in-production

# Static bearer token required by the API (as permitted by the assignment)
STATIC_API_TOKEN=static-blacklist-token

# Create tables automatically on startup (used on AWS Beanstalk)
AUTO_CREATE_TABLES=0

# Version reported by GET /health (useful to track deployments)
APP_VERSION=1.0.0

# New Relic APM (Entrega 4). The agent starts with `newrelic-admin run-program`
# (see Dockerfile). Without a license key the agent stays disabled.
NEW_RELIC_LICENSE_KEY=your-new-relic-ingest-license-key
NEW_RELIC_APP_NAME=grupo16-blacklist-dev
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
