# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# PostgreSQL connection (local or AWS RDS)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blacklist

# Secret used to sign/verify JWTs
JWT_SECRET_KEY=change-me-in-production

# Static bearer token required by the API (as permitted by the assignment)
STATIC_API_TOKEN=static-blacklist-token
